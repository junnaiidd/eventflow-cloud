# systemd unit: /etc/systemd/system/eventflow.service
[Unit]
Description=EventFlow
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/eventflow
EnvironmentFile=/etc/eventflow.env
ExecStart=/usr/bin/java -jar /opt/eventflow/eventflow.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
