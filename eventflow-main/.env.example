# Copy to /etc/eventflow.env on the EC2 server (chmod 600) - never commit real values.
SPRING_PROFILES_ACTIVE=prod

# RDS MySQL
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=eventflow
DB_USERNAME=eventflow_app
DB_PASSWORD=change-me

# S3 (private bucket). Credentials come from the EC2 instance role; do not put keys here unless you must.
S3_BUCKET=your-eventflow-bucket
AWS_REGION=ap-south-1

# First administrator (created at start-up if the e-mail does not exist)
ADMIN_EMAIL=admin@yourdomain.example
ADMIN_PASSWORD=change-me-too

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
